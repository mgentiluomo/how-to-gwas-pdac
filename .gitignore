# Generated learner setup manifests
scripts/dev/section_manifest.txt
scripts/dev/script_manifest.txt
scripts/dev/tool_manifest.tsv

# Generated learner tool installs
tools/

# Large generated QC/runtime outputs inside tutorial section result folders.
# Keep small summaries/plots in results folders; regenerate PLINK datasets locally.
sections/**/results/*.bed
sections/**/results/*.bim
sections/**/results/*.fam
sections/**/results/*.log
sections/**/results/*.afreq
sections/**/results/*.smiss
sections/**/results/*.vmiss
sections/**/results/*.het
sections/**/results/*.hardy
sections/**/results/*.hardy.*
sections/**/results/*.genome
sections/**/results/*.sexcheck
sections/**/results/*.id
sections/**/results/*.prune.in
sections/**/results/*.prune.out
sections/**/results/*_visualizations.R

# Canonical run artefacts. The pipeline writes into these; they are inputs and
# intermediates, not results to be published, and demo_data alone is ~180 MB.
# The small artefacts that ARE committed are copied into sections/*/results/
# by scripts/dev/run_all.sh.
/demo_data/
/results/
/logs/
/data_processed/

# Genome-wide intermediate and raw output. These are regenerated in minutes by
# scripts/dev/run_all.sh and together weigh about 80 MB, which git would carry
# permanently. The repository commits summaries, tables and figures.
#
# NOTE: the full summary statistics are NOT discarded. Section 7 asks authors to
# deposit them, so they belong in the data release and the Zenodo deposit, not
# in version control. Attach them when the resource is frozen.
sections/**/results/*.glm.logistic.hybrid
sections/**/results/*.glm.linear
sections/**/results/*.tsv.gz
sections/**/results/*.vcor
sections/**/results/pdac_demo_07_ibd_pi_hat_annotated.tsv
sections/**/results/pdac_demo_07_king_vs_pihat_comparison.tsv
